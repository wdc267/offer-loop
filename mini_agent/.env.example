# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，不要提交。
# 优先级：进程环境变量 > .env > 代码默认值。

# provider：deepseek（真实模型）或 fake（离线回声，不需要 key）
MINI_AGENT_PROVIDER=deepseek

# OpenAI 兼容端点。DeepSeek 默认值如下；
# 通义千问、智谱等只需替换 base_url 和 model。
MINI_AGENT_API_KEY=
MINI_AGENT_BASE_URL=https://api.deepseek.com
MINI_AGENT_MODEL=deepseek-chat

# 循环与采样参数
MINI_AGENT_MAX_STEPS=8
MINI_AGENT_TEMPERATURE=0.3
